{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IakaCockpit",
  "version": "0.31.1",
  "identifier": "com.iakateam.iakacockpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3020",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IakaCockpit",
        "width": 1280,
        "height": 820,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:4000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
